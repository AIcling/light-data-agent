# ===============================
# LLM Provider Configuration
# ===============================

LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_TIMEOUT=60

# ===============================
# Application Configuration
# ===============================

APP_ENV=development
MAX_UPLOAD_SIZE_MB=50
MAX_RESULT_ROWS=100
MAX_SQL_REPAIR_ATTEMPTS=1
QUERY_TIMEOUT_SECONDS=30

# ===============================
# Security Configuration
# ===============================

ENABLE_SQL_VALIDATION=true
ALLOW_WRITE_SQL=false
MASK_SENSITIVE_COLUMNS=true

# ===============================
# Workspace
# ===============================

ENABLE_PROJECT_WORKSPACE=true
WORKSPACE_STORAGE_DIR=storage/projects
DEFAULT_PROJECT_NAME=Default Project

# ===============================
# Persistence
# ===============================

PERSISTENCE_BACKEND=sqlite
SQLITE_DB_PATH=storage/data_agent.db

# ===============================
# Memory
# ===============================

ENABLE_PERSISTENT_MEMORY=true
MEMORY_CONFIDENCE_THRESHOLD=0.65
ALLOW_USER_MEMORY_EDIT=true

# ===============================
# Multi-step Planning
# ===============================

ENABLE_MULTI_STEP_PLAN=true
MAX_PLAN_STEPS=6
ENABLE_PLAN_REVISION=true
ENABLE_RESULT_CRITIC=true
MIN_TREND_POINTS=3

# ===============================
# Trace & Reporting
# ===============================

ENABLE_TRACE_LOGGING=true
REPORTS_DIR=reports
LOGS_DIR=logs
